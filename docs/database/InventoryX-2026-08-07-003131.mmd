erDiagram

    EMPRESA ||--o{ USUARIO : possui
    EMPRESA ||--o{ CATEGORIA : possui
    EMPRESA ||--o{ FORNECEDOR : possui
    EMPRESA ||--o{ PRODUTO : possui
    EMPRESA ||--o{ MOVIMENTACAO : registra
    EMPRESA ||--o{ AUDITORIA : possui

    CATEGORIA ||--o{ PRODUTO : classifica

    FORNECEDOR ||--o{ PRODUTO : fornece

    PRODUTO ||--o{ MOVIMENTACAO : possui

    USUARIO ||--o{ MOVIMENTACAO : realiza

